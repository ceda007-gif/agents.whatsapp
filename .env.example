# Proveedor de IA a usar: "gemini" (tiene nivel gratuito) o "anthropic" (Claude)
AI_PROVIDER=gemini

# Clave de API de Google Gemini (https://aistudio.google.com/apikey), requerida si AI_PROVIDER=gemini
GEMINI_API_KEY=

# Clave de API de Anthropic (https://console.anthropic.com/), requerida si AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Modelo a utilizar. Por defecto: gemini-3.1-flash-lite (gemini) o claude-sonnet-5 (anthropic)
AI_MODEL=

# Prompt de sistema que define la personalidad/comportamiento del agente
SYSTEM_PROMPT=Eres un asistente de WhatsApp amable, claro y conciso. Responde siempre en el idioma del usuario.

# Cantidad máxima de mensajes (usuario + asistente) que se conservan por chat
MAX_HISTORY_MESSAGES=20

# Máximo de tokens de salida por respuesta
MAX_OUTPUT_TOKENS=1024

# Lista de números permitidos (formato E.164 sin "+", el mismo que manda Meta), separados por coma
# (vacío = responder a todos). Ejemplo: 5215512345678,5215587654321
ALLOWED_CHAT_IDS=

# Prefijo para comandos como /reset o /ayuda
COMMAND_PREFIX=/

# --- WhatsApp Cloud API (Meta for Developers) ---
# Ver README para los pasos de configuración en developers.facebook.com

# Token de acceso (temporal o permanente) de tu app de Meta
WHATSAPP_TOKEN=

# Phone Number ID del número de prueba (o de tu número verificado)
WHATSAPP_PHONE_NUMBER_ID=

# Token secreto que tú inventas, para verificar el webhook con Meta
WHATSAPP_VERIFY_TOKEN=

# Versión de la Graph API a usar
WHATSAPP_API_VERSION=v23.0

# Puerto donde corre el servidor del webhook
PORT=3000

# --- Mitigaciones de control de costos / buen comportamiento ---

# Rango de delay (ms) tipo "humano" antes de enviar cada respuesta
MIN_REPLY_DELAY_MS=1500
MAX_REPLY_DELAY_MS=6000

# Espaciado mínimo (ms) entre dos mensajes salientes cualesquiera
MIN_MESSAGE_INTERVAL_MS=2500

# Máximo de respuestas de IA por chat dentro de la ventana de tiempo
MAX_MESSAGES_PER_CHAT_WINDOW=8
CHAT_RATE_WINDOW_MS=300000
