# --- Único valor obligatorio en este archivo ---
# Contraseña para entrar al panel /admin, donde configuras todo lo demás
# (token de WhatsApp, API key de IA, info del negocio) desde una página web,
# sin volver a tocar archivos ni la terminal. Invéntala tú.
ADMIN_PASSWORD=

# --- El resto de esto ya NO se configura aquí: se hace desde /admin ---
# (AI_PROVIDER, GEMINI_API_KEY, ANTHROPIC_API_KEY, AI_MODEL, SYSTEM_PROMPT,
#  WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_VERIFY_TOKEN)
# Esos valores se guardan en data/settings.json la primera vez que los
# guardas desde el panel. Si ya tenías un .env de una versión anterior,
# esos valores se usan como semilla inicial.

# Cantidad máxima de mensajes (usuario + asistente) que se conservan por chat
MAX_HISTORY_MESSAGES=20

# Máximo de tokens de salida por respuesta
MAX_OUTPUT_TOKENS=1024

# Lista de números permitidos (formato E.164 sin "+", el mismo que manda Meta), separados por coma
# (vacío = responder a todos). Ejemplo: 5215512345678,5215587654321
ALLOWED_CHAT_IDS=

# Prefijo para comandos como /reset o /ayuda
COMMAND_PREFIX=/

# Versión de la Graph API de Meta a usar
WHATSAPP_API_VERSION=v23.0

# Puerto donde corre el servidor (webhook + panel /admin)
PORT=3000

# --- Control de costos / buen comportamiento ---

# Rango de delay (ms) antes de enviar cada respuesta
MIN_REPLY_DELAY_MS=1500
MAX_REPLY_DELAY_MS=6000

# Espaciado mínimo (ms) entre dos mensajes salientes cualesquiera
MIN_MESSAGE_INTERVAL_MS=2500

# Máximo de respuestas de IA por chat dentro de la ventana de tiempo
MAX_MESSAGES_PER_CHAT_WINDOW=8
CHAT_RATE_WINDOW_MS=300000
